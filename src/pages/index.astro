---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Parser from 'rss-parser';

// 1. Initialize the parser
const parser = new Parser();

// 2. Fetch the data from Riverside at build time
const feed = await parser.parseURL('https://api.riverside.com/hosting/2Aa5Dpi9.rss');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Latest Episodes</h1>
				<ul>
					{
						feed.items.map((episode) => (
							<li style="margin-bottom: 2rem;">
								<a href={episode.link}>
									<h4 class="title">{episode.title}</h4>
								</a>
								<p class="date">
									{new Date(episode.pubDate).toLocaleDateString('en-us', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</p>
                                <!-- The Audio Player -->
                                <audio controls style="width: 100%; margin-top: 0.5rem;">
                                    <source src={episode.enclosure.url} type="audio/mpeg" />
                                    Your browser does not support the audio element.
                                </audio>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>